[% plugin_output      = remove_html_comments(obj.plugin_output) %]
[% long_plugin_output = remove_html_comments(obj.long_plugin_output) %]
[% escape_output      = thruk_escape_html_tags(obj, escape_html_tags) %]

[% IF obj.has_been_checked == 0 %]obj has not been checked yet[% END %]
[% IF escape_output %][% nl2br(escape_html(plugin_output)) | replace_links | replace_copy_paste %][% ELSE %][% plugin_output | replace_links | replace_copy_paste %][% END %]
[% IF long_plugin_output %]
  <br>[% IF escape_output %][% nl2br(maybe_pre(escape_html(long_plugin_output))) | replace_links | replace_copy_paste %][% ELSE %][% plugin_output_as_html(maybe_pre(long_plugin_output)) | replace_links | replace_copy_paste %][% END %]
[% END %]
