<script>
function resizeGraphIFrame(obj) {
  try {
    obj.style.height = obj.contentWindow.document.body.scrollHeight + 'px';
  } catch(e) {}
}
var hideTooltipTimer = null;
var scheduleHideTooltip = function() {
  clearTimeout(hideTooltipTimer);
  hideTooltipTimer = setTimeout(function(){ jQuery("#tooltip").remove(); }, 300);
};
jQuery(document).ready(function() {
  jQuery("a.histou_tips, a.tips").hover(
    function(e){
      clearTimeout(hideTooltipTimer);
      jQuery("#tooltip").remove();
      var popup_width   = 600;
      var popup_height  = 200;
      var url           = this.rel;
      var icon_pos      = jQuery(this).offset();
      var popup_pos_x   = icon_pos.left + jQuery(this).outerWidth() + 5;
      if(icon_pos.left + popup_width > jQuery(window).width()) {
        popup_pos_x  = icon_pos.left - popup_width - 5;
      }

      var showPopup = function(url) {
        jQuery("#tooltip").remove();
        jQuery("body").append("<div id='tooltip' class='rounded-lg overflow-hidden'><iframe src='"+url+"' width='"+popup_width+"' height='"+popup_height+"' frameBorder='0' scrolling='no' onload='resizeGraphIFrame(this)'><\/iframe><\/div>");
        jQuery("#tooltip")
          .css("position","absolute")
          .css("z-index","15")
          .css("top", icon_pos.top + "px")
          .css("left", popup_pos_x + "px")
          .on("mouseenter", function(){ clearTimeout(hideTooltipTimer); })
          .on("mouseleave", scheduleHideTooltip)
          .fadeIn("fast");
      };

      var params = toQueryParams(url);
      if(params["panelId"] && !jQuery.isNumeric(params["panelId"])) {
        fetchHistouPanelId(url, params["panelId"], params["host"], params["service"], function(newId) {
          if(newId === "null") {
          } else {
            url = url.replace("&panelId="+params["panelId"], "&panelId="+newId);
            showPopup(url);
          }
        });
      } else {
        showPopup(url);
      }
    },
      function(){
        scheduleHideTooltip();
      }
  );
  jQuery(document).on("click", function(){
    clearTimeout(hideTooltipTimer);
    jQuery("#tooltip").remove();
  });
});
</script>
