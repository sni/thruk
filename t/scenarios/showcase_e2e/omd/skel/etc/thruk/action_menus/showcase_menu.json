        "html": "<div class='flexrow gap-1 flex-nowrap'><b>note:</b><input type='text' id='showcase_note_input' style='width:160px' placeholder='service note'><button onclick=\"(function(b){var i=document.getElementById('showcase_note_input');var v=i.value;if(!v){thruk_message(1,'please enter a note');return;}jQuery(b).attr('disabled',true).text('saving...');jQuery.post('status.cgi?serveraction=1&json=1',{link:'server://showcase_note/'+encodeURIComponent(v),host:action_menu_options.host,service:action_menu_options.service,backend:action_menu_options.backend,token:CSRFtoken},function(r){thruk_message(r.rc,r.msg);action_menu_close();});})(this)\">save</button></div>"
      },
