            "html": "<div style='display:flex;align-items:center;gap:8px;width:370px;padding:6px 10px;background:linear-gradient(90deg,#2c3e50,#3498db);border-radius:6px;color:#fff;font-size:13px'><b>rate:</b><select id='showcase_rating_select' style='width:110px'><option value='great'>great</option><option value='ok'>ok</option><option value='bad'>bad</option></select><button onclick=\"(function(b){var s=document.getElementById('showcase_rating_select');jQuery(b).attr('disabled',true).text('saving...');jQuery.post('status.cgi?serveraction=1&json=1',{link:'server://showcase_note/rating: '+s.value,host:action_menu_options.host,service:action_menu_options.service,backend:action_menu_options.backend,token:CSRFtoken},function(r){thruk_message(r.rc,r.msg);action_menu_close();});})(this)\">send</button></div>"
