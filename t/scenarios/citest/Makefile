include ../_common/Makefile.common

GENERATED_COMPOSE_FILE = volumes.generated.yml
# merge generated /var/lib/naemon/thruk/* ro volumes into every docker compose call, only once the file was generated
export COMPOSE_FILE = docker-compose.yml$(shell [ -f $(GENERATED_COMPOSE_FILE) ] && echo ":$(GENERATED_COMPOSE_FILE)")

pre_prepare:
	cp -p ../../../.ci/prepare_machine.sh citest/
	echo '# generated by make pre_prepare - do not edit' > $(GENERATED_COMPOSE_FILE)
	echo services: >> $(GENERATED_COMPOSE_FILE)
	echo '  site:' >> $(GENERATED_COMPOSE_FILE)
	printf '    volumes:\n' >> $(GENERATED_COMPOSE_FILE)
	for dir in docs lib script ssi support t templates themes; do \
	    echo "        - ../../../$$dir:/var/lib/naemon/thruk/$$dir:ro" >> $(GENERATED_COMPOSE_FILE); \
	done
	# writable parent so new plugins can be added, read-only subfolders for existing ones
	echo "        - ../../../plugins/plugins-available:/var/lib/naemon/thruk/plugins/plugins-available" >> $(GENERATED_COMPOSE_FILE)
	ls -1 ../../../plugins/plugins-available/ | while read p; do \
	    echo "        - ../../../plugins/plugins-available/$$p:/var/lib/naemon/thruk/plugins/plugins-available/$$p:ro" >> $(GENERATED_COMPOSE_FILE); \
	done

extra_prepare:
	rm -rf citest/prepare_machine.sh
	docker compose exec site /thruk/t/scenarios/citest/extra_prepare.sh

wait_start:
	for x in $$(seq $(STARTUPWAIT)); do \
	   if [ $$(docker compose logs | grep "failed=" | grep -v "failed=0" | wc -l) -gt 0 ]; then $(MAKE) wait_start_failed; exit 1; fi; \
	   if [ $$(docker compose logs | grep "| ERROR" | wc -l) -gt 0 ]; then $(MAKE) wait_start_failed; exit 1; fi; \
	   if [ $$(docker compose logs | grep "ci container ready" | wc -l) -eq 1 ]; then break; else sleep 1; fi; \
	   if [ $$x -eq $(STARTUPWAIT) ]; then $(MAKE) wait_start_failed; exit 1; fi; \
	done
	docker ps

test: wait_start
	docker compose exec $(DOCKER_COMPOSE_TTY) site /thruk/t/scenarios/citest/test.sh $(filter-out $@,$(MAKECMDGOALS))

test_verbose: wait_start
	docker compose exec $(DOCKER_COMPOSE_TTY) site /thruk/t/scenarios/citest/test.sh 1 $(filter-out $@,$(MAKECMDGOALS))

server: wait_start
	docker compose exec $(DOCKER_COMPOSE_TTY) site /thruk/t/scenarios/citest/server.sh $(filter-out $@,$(MAKECMDGOALS))

extra_clean:
	rm -f $(GENERATED_COMPOSE_FILE)
