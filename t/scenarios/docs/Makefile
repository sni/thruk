include ../_common/Makefile.common

export THRUK_TEST_AUTH = omdadmin:omd

# doc tests run on the host and load Thruk modules from the repo, so prepend the repo lib dir to PERL5LIB
export PERL5LIB := $(abspath ../../../lib):$(PERL5LIB)

# the doc tests are meant to run like `make docs` from the repo root, so the config dir must be the repo root
# etc_path must equal the test CWD, otherwise the doc_rest script writes bp/panorama files the plugins cannot find
export THRUK_CONFIG := $(abspath ../../..)

# the doc_rest test expects a non-empty thruk_local.conf in the test CWD (repo root).
# The scenario config itself is installed as thruk_local.d/docs-scenario.conf.
# An existing repo-root thruk_local.conf (e.g. from a developer or from `make citest`
# which copies t/ci/thruk_local.conf there) would add extra backend peers, so during
# the run it is moved aside to thruk_local.conf.docs-backup and restored again by
# extra_clean. A minimal marker thruk_local.conf is then created for the `-s` gate.
pre_prepare:
	mkdir -p ../../../thruk_local.d
	cp thruk_local.conf ../../../thruk_local.d/docs-scenario.conf
	if test -s ../../../thruk_local.conf && ! grep -q 'generated by t/scenarios/docs' ../../../thruk_local.conf; then mv ../../../thruk_local.conf ../../../thruk_local.conf.docs-backup; fi
	test -s ../../../thruk_local.conf || printf '# generated by t/scenarios/docs, config lives in thruk_local.d/\n' > ../../../thruk_local.conf

wait_start:
	$(THRUK) cache clean
	for x in $$(seq $(STARTUPWAIT)); do \
	   if [ $$(docker compose logs | grep "failed=" | grep -v "failed=0" | wc -l) -gt 0 ]; then $(MAKE) wait_start_failed; exit 1; fi; \
	   if [ $$(curl -s http://127.0.0.3:60080/demo/thruk/cgi-bin/login.cgi | grep -c loginuser) -gt 0 ] && [ $$($(THRUK) -l 2>&1 | grep -v ^Def | grep -v ^- | grep -v ERROR | grep OK | wc -l) -eq $(EXPECTED_BACKENDS) ]; then break; else sleep 1; fi; \
	   if [ $$x -eq $(STARTUPWAIT) ]; then $(MAKE) wait_start_failed; exit 1; fi; \
	done

wait_start_failed_extra:
	-curl -kv http://127.0.0.3:60080/demo/thruk/cgi-bin/login.cgi
	-$(THRUK) -vvv -l
	-bash -c 'exec 3<>/dev/tcp/127.0.0.3/60557' || echo "livestatus TCP socket 127.0.0.3:60557 is not reachable"

extra_clean:
	-rm -f ../../../thruk_local.d/docs-scenario.conf
	-rmdir ../../../thruk_local.d 2>/dev/null || :
	-grep -q 'generated by t/scenarios/docs' ../../../thruk_local.conf 2>/dev/null && rm -f ../../../thruk_local.conf
	-test -f ../../../thruk_local.conf.docs-backup && mv ../../../thruk_local.conf.docs-backup ../../../thruk_local.conf
	-rm -rf ../../../var/tmp/naemon

# copy the naemon config from the container into the shared var/tmp mount so the host-side configtool can build the object model.
# The copied naemon.cfg is replaced with a minimal one resolving cfg_dir relative to its own dir.
extra_prepare:
	docker compose exec $(DOCKER_COMPOSE_TTY) --user root omd sh -c 'rm -rf /var/tmp/naemon && cp -a /omd/sites/demo/etc/naemon /var/tmp/naemon && chmod -R a+rwX /var/tmp/naemon'
	@printf 'cfg_dir=conf.d\nresource_file=resource.cfg\n' > ../../../var/tmp/naemon/naemon.cfg
	$(MAKE) pre_prepare
